# Required on Vercel — add in Project Settings → Environment Variables
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sierralink_transportation
ADMIN_EMAIL=info@sierralinkexecutivetransportation.com
ADMIN_PASSWORD=change-this-before-production
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Production site URL (use your domain after DNS is connected)
NEXT_PUBLIC_SITE_URL=https://sierralinkexecutivetransportation.com

# Email notifications
# ADMIN_EMAIL = primary business inbox for booking alerts
# SMTP_USER = Gmail account used to send mail; also receives booking alerts as backup
# Gmail: enable 2FA, create an App Password, use smtp.gmail.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sierralink.bookings@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=SierraLink Bookings <sierralink.bookings@gmail.com>

# Optional secure payment processing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYMENTS_ENABLED=false

# Optional address autocomplete/analytics
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
